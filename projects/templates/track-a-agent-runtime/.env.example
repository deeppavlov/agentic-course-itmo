# Скопируй в .env и заполни. .env не коммитится.
LLM_PROVIDER_URL=
LLM_API_KEY=                # живёт только в llm-proxy, в сандбокс не попадает
GATEWAY_PORT=8080
CLIENT_TOKENS=              # токены доступа клиентов
SANDBOX_CPU=1
SANDBOX_MEMORY=1g
SANDBOX_PIDS=256
SANDBOX_DISK=2g
SANDBOX_EXEC_TIMEOUT_S=120
